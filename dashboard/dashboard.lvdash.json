{
  "datasets": [
    {
      "name": "838a295a",
      "displayName": "season_stats",
      "config": {
        "version": "1.1",
        "source": "football_prod.gold.season_stats",
        "dimensions": [
          {
            "name": "season_year",
            "expr": "season_year",
            "displayName": "Temporada"
          },
          {
            "name": "country",
            "expr": "country",
            "displayName": "País"
          },
          {
            "name": "league_name",
            "expr": "league_name",
            "displayName": "Liga"
          }
        ],
        "measures": [
          {
            "name": "total_matches",
            "expr": "SUM(conteo)",
            "displayName": "Total Partidos",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "total_goals",
            "expr": "SUM(total_goals)",
            "displayName": "Total Goles",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "max_goals",
            "expr": "MAX(max_goals)",
            "displayName": "Máx Goles en Partido"
          },
          {
            "name": "min_goals",
            "expr": "MIN(min_goals)",
            "displayName": "Mín Goles en Partido"
          },
          {
            "name": "classic_count",
            "expr": "SUM(classic_count)",
            "displayName": "Clásicos",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "home_wins",
            "expr": "SUM(home_win_count)",
            "displayName": "Victorias Locales",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 0.0
              }
            }
          },
          {
            "name": "avg_goals_per_match",
            "expr": "SUM(total_goals) * 1.0 / SUM(conteo)",
            "displayName": "Promedio Goles/Partido",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "home_win_pct",
            "expr": "SUM(home_win_count) * 1.0 / SUM(conteo)",
            "displayName": "% Victoria Local",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    }
  ],
